{{- if eq .Dialect "mysql" -}}
# Code generated by togo. Atlas schema fragment (MySQL) — safe to edit.
table "{{.Resource.Table}}" {
  schema = schema.{{.AtlasSchema}}
  column "id" {
    null    = false
    type    = sql("char(36)")
    default = sql("(uuid())")
  }
{{- range .Resource.Fields}}
  column "{{.Name}}" {
    null = {{.Null}}
    type = {{atlasCol "mysql" .}}
  }
{{- end}}
  column "created_at" {
    null    = false
    type    = sql("datetime(6)")
    default = sql("CURRENT_TIMESTAMP(6)")
  }
  column "updated_at" {
    null      = false
    type      = sql("datetime(6)")
    default   = sql("CURRENT_TIMESTAMP(6)")
    on_update = sql("CURRENT_TIMESTAMP(6)")
  }
  primary_key {
    columns = [column.id]
  }
}
{{- else if eq .Dialect "postgres" -}}
# Code generated by togo. Atlas schema fragment (PostgreSQL) — safe to edit.
table "{{.Resource.Table}}" {
  schema = schema.{{.AtlasSchema}}
  column "id" {
    type    = uuid
    default = sql("gen_random_uuid()")
  }
{{- range .Resource.Fields}}
  column "{{.Name}}" {
    null = {{.Null}}
    type = {{atlasCol "postgres" .}}
  }
{{- end}}
  column "created_at" {
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
}
{{- else -}}
# Code generated by togo. Atlas schema fragment (SQLite) — safe to edit.
table "{{.Resource.Table}}" {
  schema = schema.{{.AtlasSchema}}
  column "id" {
    null    = true
    type    = text
    default = sql("lower(hex(randomblob(16)))")
  }
{{- range .Resource.Fields}}
  column "{{.Name}}" {
    null = {{.Null}}
    type = {{atlasCol "sqlite" .}}
  }
{{- end}}
  column "created_at" {
    null    = false
    type    = datetime
    default = sql("datetime('now')")
  }
  column "updated_at" {
    null    = false
    type    = datetime
    default = sql("datetime('now')")
  }
  primary_key {
    columns = [column.id]
  }
}
{{- end}}
