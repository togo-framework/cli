VALUES ({{range $i, $f := .Resource.Fields}}{{if $i}}, {{end}}${{inc $i}}{{end}})
RETURNING *;
{{- else -}}
INSERT INTO {{.Resource.Table}} DEFAULT VALUES RETURNING *;
{{- end}}

-- name: Delete{{.Resource.Name}} :exec
DELETE FROM {{.Resource.Table}} WHERE id = $1;
